# حماية مجلد src من الوصول المباشر
Order Deny,Allow
Deny from all

# منع عرض محتويات المجلد
Options -Indexes

# حماية ملفات TypeScript و JavaScript
<Files "*.ts">
    Order Deny,Allow
    Deny from all
</Files>

<Files "*.tsx">
    Order Deny,Allow
    Deny from all
</Files>

<Files "*.js">
    Order Deny,Allow
    Deny from all
</Files>

<Files "*.jsx">
    Order Deny,Allow
    Deny from all
</Files>

# حماية ملفات التكوين
<Files "*.json">
    Order Deny,Allow
    Deny from all
</Files>
